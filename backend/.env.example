# PragyanBridge Backend Environment Configuration Template
# SIH 2026 Problem Statement 26044 • Team Echelon

# Path to SQLite database (defaults to backend/pragyanbridge.db)
DB_PATH=pragyanbridge.db

# Allowed CORS Origins (comma-separated). Defaults to local development origins if omitted.
# Example for production: https://pragyanbridge.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: Google Gemini API key for advisory GenAI learning roadmap generation.
# If omitted, PragyanBridge automatically uses the built-in deterministic rule-based roadmap engine.
# NEVER commit real API keys to version control.
GEMINI_API_KEY=your_gemini_api_key_here
